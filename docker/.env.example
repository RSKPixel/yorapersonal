APP_NAME="Yora Personal"
APP_ENV=production
DATABASE_URL=mysql+pymysql://DB_USER:URL_ENCODED_PASSWORD@homeserver:3306/DB_NAME?charset=utf8mb4
JWT_SECRET_KEY=replace_with_a_strong_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://your-public-hostname
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8006
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8088
VITE_API_BASE_URL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_at_least_8_characters
INITIAL_ADMIN_NAME=Administrator
PROXY_NETWORK=nginx-proxy-manager_default
